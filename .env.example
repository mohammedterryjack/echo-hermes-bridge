# Environment for bridge.py (Hermes passes it via config.yaml mcp_servers.echo.env). Paths only for keys: never the keys themselves.
# the Echo Show (ESPHome API on :6053, SSH as root)
ECHO_HOST=192.0.2.40
ECHO_KEY_FILE=~/path/to/echo-esphome.key
ECHO_SSH_KEY=~/.ssh/echo_key
# Wyoming Piper TTS host:port and voice
ECHO_TTS=192.0.2.30:10200
ECHO_TTS_VOICE=<piper-voice-name>
# this machine's LAN address for the look/speak/video-relay servers (never 0.0.0.0)
BRIDGE_BIND=192.0.2.10
# this machine's Hermes API server (runs for the splat/vision/synth profiles, /health/detailed)
HERMES_API_URL=http://192.0.2.10:8642
# GPU box media gateway; its Bearer key comes from the Hermes .env, not this file
DELL_MEDIA_URL=http://192.0.2.20:8091
DELL_LLM_API_KEY=
# other Hermes agents on the LAN for ask_hermes_agent (keys from the Hermes .env)
HERMES_PEER_DELL_URL=http://192.0.2.20:8642
HERMES_PEER_IMAC_URL=http://imac.local:8642
HERMES_PEER_MACMINI_URL=http://192.0.2.30:8642
HERMES_PEER_DELL_KEY=
HERMES_PEER_IMAC_KEY=
HERMES_PEER_MACMINI_KEY=
